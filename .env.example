# --- Search / discovery -------------------------------------------------
# SerpAPI gives the most reliable Google results (https://serpapi.com).
# If unset, the agent falls back to DuckDuckGo (free, lower volume).
SERPAPI_KEY=

# Google Places API key (optional but strongly recommended for accurate
# name/address/phone and review counts). Enable "Places API" in GCP.
GOOGLE_PLACES_API_KEY=

# --- Enrichment ----------------------------------------------------------
# https://hunter.io/api-keys  (domain search + email finder + company data)
HUNTER_API_KEY=
# https://rocketreach.co/api  (owner/decision-maker contact lookup)
ROCKETREACH_API_KEY=

# --- Output --------------------------------------------------------------
# ID of the target Google Sheet (the long string in the sheet URL).
GOOGLE_SHEET_ID=
# Worksheet (tab) name to write to.
GOOGLE_SHEET_WORKSHEET=Leads
# Path to a Google service-account JSON key. Share the sheet with the
# service account's email (Editor). If unset, leads are written to
# out/leads.csv instead.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
