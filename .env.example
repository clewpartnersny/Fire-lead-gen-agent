# --- Search / discovery -------------------------------------------------
# Serper (https://serper.dev) - preferred: real Google results AND Google
# Maps places with review counts, no GCP account needed.
SERPER_API_KEY=
# SerpAPI (https://serpapi.com) - alternative Google results source.
# If neither is set, the agent falls back to DuckDuckGo (free, flakier).
SERPAPI_KEY=

# Official Google Places API key (optional; Serper covers the same data).
GOOGLE_PLACES_API_KEY=

# --- Enrichment ----------------------------------------------------------
# https://hunter.io/api-keys  (domain search + email finder + company data)
HUNTER_API_KEY=
# https://rocketreach.co/api  (owner/decision-maker contact lookup)
ROCKETREACH_API_KEY=

# --- Output --------------------------------------------------------------
# Option A (needs Google Cloud admin): service account.
# ID of the target Google Sheet (the long string in the sheet URL).
GOOGLE_SHEET_ID=
# Worksheet (tab) name to write to.
GOOGLE_SHEET_WORKSHEET=Leads
# Path to a Google service-account JSON key. Share the sheet with the
# service account's email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# Option B (NO admin needed): Apps Script webhook. Paste
# docs/google_apps_script.gs into the sheet (Extensions -> Apps Script),
# deploy as Web app, and put the /exec URL + your secret here.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# If neither is set, leads go to out/leads.csv (same columns).
